{
  "schemaVersion": 1,
  "id": "francisco.eq",
  "name": "Equalizer",
  "version": "1.4.0",
  "author": "Francisco",
  "license": "MIT",
  "description": "12-band equalizer (20 Hz - 20 kHz) with a real-time audio spectrum (cava) and curve presets for the PipeWire Equalizer output.",
  "homepage": "https://github.com/videfrancisco/EQ_minimal_omarchy",
  "repository": "https://github.com/videfrancisco/EQ_minimal_omarchy",
  "keywords": [
    "eq",
    "equalizer",
    "spectrum",
    "presets",
    "audio"
  ],
  "kinds": [
    "bar-widget",
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Equalizer",
    "description": "Opens the 12-band equalizer with an audio spectrum",
    "category": "Utilities",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
